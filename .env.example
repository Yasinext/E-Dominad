APP_ENV=production
APP_NAME=domainbot
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_FORMAT=json

TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_IDS=

DATABASE_URL=postgresql+asyncpg://domainbot:CHANGE_ME@127.0.0.1:5432/domainbot

RDAP_BASE_URL=https://rdap.verisign.com/com/v1
RDAP_CONCURRENCY=3
RDAP_CONNECT_TIMEOUT_SECONDS=10
RDAP_READ_TIMEOUT_SECONDS=20
RDAP_WRITE_TIMEOUT_SECONDS=10
RDAP_POOL_TIMEOUT_SECONDS=10
RDAP_MAX_ATTEMPTS=3
RDAP_USER_AGENT=

MAX_DOMAINS_PER_COMMAND=100
MAX_DOMAINS_PER_WATCH=5000
MAX_ACTIVE_JOBS_PER_GROUP=1
MAX_ACTIVE_JOBS_PER_USER=1
REPORT_MESSAGE_ROW_LIMIT=20

WATCH_TIMEZONE=Europe/Istanbul
WATCH_DEFAULT_DAY=MON
WATCH_DEFAULT_HOUR=10
WATCH_DAILY_BATCH_SIZE=300

BTK_BASE_URL=https://btk.monoworks.net
BTK_BATCH_SIZE=25
BTK_IDLE_SLEEP_SECONDS=30
BTK_BATCH_SLEEP_SECONDS=5
BTK_RETRY_INTERVAL_SECONDS=21600
BTK_CONNECT_TIMEOUT_SECONDS=10
BTK_READ_TIMEOUT_SECONDS=30
BTK_WRITE_TIMEOUT_SECONDS=10
BTK_POOL_TIMEOUT_SECONDS=10
BTK_USER_AGENT=

TEMP_REPORT_DIR=/var/lib/domainbot/reports
